# Copy to .env and fill in real values. Never commit .env.

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev

# --- Database (Docker Compose: db service) ---
POSTGRES_DB=vst
POSTGRES_USER=vst
POSTGRES_PASSWORD=changeme
DB_PORT=5432

# --- Database (backend datasource, matches values above) ---
DB_HOST=localhost
DB_NAME=vst
DB_USER=vst
DB_PASSWORD=changeme

# --- Python (vnstock service) ---
# Optional. Without it, vnstock rate-limits to 20 req/min ("Guest" tier); with it, 60 req/min
# ("Community" tier). Get one at https://vnstocks.com/login. Set as an env var (not via
# vnai.setup_api_key() in code) so vnai doesn't phone home with device info — see python/README.md.
VNSTOCK_API_KEY=
